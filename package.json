{
  "name": "@idea2app/lark-next-shadcn-ts",
  "version": "2.4.0",
  "description": "Lark project scaffold based on TypeScript, React, Next.js, shadcn/ui & Tailwind CSS.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@khmyznikov/pwa-install": "^0.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.5",
    "@sentry/nextjs": "^10.75.0",
    "@serwist/next": "^9.5.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "edkit": "^1.3.2",
    "file-type": "^22.1.0",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-jwt": "^4.0.4",
    "koajax": "^3.3.1",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "lit": "^3.3.3",
    "lodash": "^4.18.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "mime": "^4.1.0",
    "mobx": "^7.0.3",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-lark": "^2.10.1",
    "mobx-react": "^10.0.2",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "next": "16.3.5",
    "next-ssr-middleware": "^1.1.1",
    "next-with-less": "^3.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.10.2",
    "web-utility": "^4.7.2",
    "webpack": "^5.111.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/formidable": "^3.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.25",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-idea2app-next-js": "^0.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.7",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-helper": "^0.5.9",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "next": "$next"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover",
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky",
    "install": "shadcn-helper install && next typegen",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t idea2app/lark-next-shadcn-ts:latest .",
    "container": "docker rm -f lark-next-shadcn-ts  &&  docker run --name lark-next-shadcn-ts -p 3000:3000 -d idea2app/lark-next-shadcn-ts:latest"
  }
}
